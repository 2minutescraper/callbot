# --- Image provider -----------------------------------------------------
# Pick one. 'auto' (the default) uses whichever key is present, preferring
# Gemini because it renders 9:16 natively instead of being cropped to it.
IMAGE_PROVIDER=auto

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Output -------------------------------------------------------------
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920

# --- Behaviour ----------------------------------------------------------
MAX_ATTEMPTS=3            # retries per photo before the fallback render
MAX_WORKERS=4             # photos transformed in parallel
MAX_UPLOAD_MB=20
REQUEST_TIMEOUT=180
ENABLE_LOCAL_FALLBACK=true

# --- Server -------------------------------------------------------------
HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=false
